# .env.local
# 1. Anthropic（Claude Haiku）
#    https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# 2. Deepgram（Nova-3 音声認識）
#    https://console.deepgram.com
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Vercel Blob（音声ファイル保存）
#    Vercel ダッシュボード > Storage > Blob で取得
#    ローカルでは `vercel link` 後に `vercel env pull` でも取得可能
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx
